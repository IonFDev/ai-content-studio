IDEOGRAM_ASPECT_RATIO=16x9
IDEOGRAM_RENDERING_SPEED=TURBO
IDEOGRAM_MAGIC_PROMPT=OFF
IDEOGRAM_CHARACTER_REFERENCE_PATH=characters/1/detective-stickman-closeup.png
IDEOGRAM_STYLE_REFERENCE_PATH=characters/1/detective-stickman-poses.png

BFL_API_KEY=
BFL_MODEL=flux-2-pro
BFL_TIMEOUT=300
BFL_POLL_INTERVAL=1
BFL_MAX_POLL_ATTEMPTS=120

ELEVENLABS_API_KEY=
